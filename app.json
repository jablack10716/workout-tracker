{
  "expo": {
    "name": "Best Damn Weight Lifting Tracker Ever",
    "slug": "WeightLiftingLog",
    "version": "1.0.0",
    "scheme": "weightliftinglog",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0f172a"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2133",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/workout-favicon.png",
      "shortName": "Workout Log",
      "description": "Track your workouts, volume landmarks, and progressive overload.",
      "themeColor": "#0f172a",
      "backgroundColor": "#020617",
      "display": "standalone",
      "orientation": "portrait",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
